# ==========================================
# NeuroStream System Configuration
# ==========================================

# Network & Ports
FASTAPI_PORT=8000
FRONTEND_PORT=3000
KAFKA_PORT=9092
KAFKA_EXTERNAL_PORT=29092
SPARK_MASTER_PORT=7077
SPARK_WEBUI_PORT=8080
HDFS_NAMENODE_PORT=9870
HDFS_DATANODE_PORT=9864
HIVE_METASTORE_PORT=9083
HIVE_SERVER2_PORT=10000
POSTGRES_PORT=5432

# PostgreSQL & Hive Metastore
POSTGRES_DB=metastore_db
POSTGRES_USER=hive
POSTGRES_PASSWORD=hivepassword

# Kafka Topics
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
TOPIC_RAW_WINDOWS=eeg.raw.windows
TOPIC_PROCESSED_FEATURES=eeg.processed.features
TOPIC_CLASSIFICATION_RESULTS=eeg.classification.results
TOPIC_PROCESSING_ERRORS=eeg.processing.errors

# Spark Configuration
SPARK_MASTER=spark://spark-master:7077
SPARK_STREAMING_BATCH_INTERVAL=1

# HDFS Configuration
HADOOP_NAMENODE_URL=hdfs://namenode:9000
HDFS_BASE_DIR=/neurostream

# Hive Configuration
HIVE_HOST=hive-server
HIVE_PORT=10000
HIVE_DATABASE=neurostream_db

# EEG Processing Configuration
SAMPLING_FREQ=160
WINDOW_DURATION=2.0
WINDOW_OVERLAP=0.5
REPLAY_SPEED=1.0

# Paths
DATA_DIR=/app/data
MODELS_DIR=/app/data/models
CHECKPOINT_DIR=/app/data/checkpoints

